# =============================================================================
# EPROC SERVER ENVIRONMENT CONFIGURATION (PER BUMN CLIENT DEPLOYMENT)
# Semua variabel ber-prefix EPROC_ otomatis meng-override appsettings.json
# =============================================================================

ASPNETCORE_ENVIRONMENT=Production
EPROC_ConnectionStrings__Default="Host=localhost;Port=5432;Database=eproc_bumn_db;Username=eproc_user;Password=secret"

# Identitas Instansi BUMN pada Server Ini
EPROC_EprocClient__ClientCode="BUMN_KARYA_01"
EPROC_EprocClient__CompanyName="PT BUMN Karya Persero Tbk"
EPROC_EprocClient__ClientShortName="BUMN Karya"
EPROC_EprocClient__Npwp="01.001.002.3-093.000"
EPROC_EprocClient__IsWapuPpn="true"
EPROC_EprocClient__RegulationReference="PER-2/MBU/03/2023"
EPROC_EprocClient__PrimaryThemeColor="#0F4C81"
EPROC_EprocClient__LogoUrl="/assets/branding/logo-bumn-karya.svg"

# Parameter Kebijakan Pengadaan & TKDN BUMN
EPROC_EprocFeatures__EnableCsmsModule="true"
EPROC_EprocFeatures__EnableEReverseAuction="true"
EPROC_EprocFeatures__EnableECatalogUmbrella="true"
EPROC_EprocFeatures__EnableTwoStageTender="true"
EPROC_EprocFeatures__MandatoryTkdnThresholdPct="40.0"
EPROC_EprocFeatures__MinTkdnPreferenceEligiblePct="25.0"
EPROC_EprocFeatures__GoodsTkdnMaxPreferencePct="25.0"
EPROC_EprocFeatures__ConstructionTkdnMaxPreferencePct="7.5"
EPROC_EprocFeatures__DefaultLatePenaltyPerMille="1.0"
EPROC_EprocFeatures__MaxPenaltyCapPct="5.0"

# Integrasi Eksternal
EPROC_EprocIntegrations__ErpProvider="SAP_S4HANA"
EPROC_EprocIntegrations__DigitalSignatureProvider="BSRE_BSSN"
EPROC_EprocIntegrations__EMeteraiProvider="PERURI"
EPROC_EprocIntegrations__PadiUmkmSyncEnabled="true"
